{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum permissions for the main TesRig window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-is-focused",
    "core:window:allow-is-minimized",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default"
  ]
}
